{
  "capability": "speech.synthesize",
  "request": {
    "params": {
      "text": "Hello from TapVid.",
      "voice": "Kore",
      "language": "en"
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/interactions",
        "bodyIncludes": {
          "model": "gemini-3.8-flash-tts",
          "generation_config": {
            "speech_config": [
              {
                "voice": "Kore"
              }
            ]
          },
          "response_format": {
            "type": "audio"
          }
        },
        "headers": {
          "x-goog-api-key": "test-GEMINI_API_KEY"
        }
      },
      "response": {
        "json": {
          "id": "v1_int",
          "model": "m",
          "object": "interaction",
          "status": "completed",
          "steps": [
            {
              "type": "user_input"
            },
            {
              "type": "model_output",
              "content": [
                {
                  "type": "audio",
                  "mime_type": "audio/wav",
                  "data": ""
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "status": "completed",
    "files": [
      {
        "mime": "audio/wav"
      }
    ]
  }
}
