{
  "capability": "video.generate",
  "request": {
    "params": {
      "prompt": "A slow push-in on a cup of coffee",
      "aspect": "16:9",
      "duration_s": 5,
      "first_frame": "_assets/tiny.png"
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/interactions",
        "bodyIncludes": {
          "model": "gemini-omni-1.1-flash",
          "task": "image_to_video",
          "response_format": {
            "type": "video",
            "aspect_ratio": "16:9",
            "resolution": "360p",
            "duration": 5
          }
        },
        "headers": {
          "x-goog-api-key": "test-GEMINI_API_KEY"
        }
      },
      "response": {
        "json": {
          "id": "v1_int",
          "model": "m",
          "object": "interaction",
          "status": "completed",
          "steps": [
            {
              "type": "user_input"
            },
            {
              "type": "model_output",
              "content": [
                {
                  "type": "video",
                  "mime_type": "video/mp4",
                  "data": ""
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "status": "completed",
    "files": [
      {
        "mime": "video/mp4"
      }
    ]
  }
}
