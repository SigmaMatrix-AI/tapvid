{
  "capability": "speech.synthesize",
  "request": {
    "params": {
      "text": "Hello world.",
      "voice": "English_expressive_narrator",
      "speed": 1.1
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://api.minimax.io/v1/t2a_v2",
        "bodyIncludes": {
          "model": "speech-2.8-hd",
          "text": "Hello world.",
          "voice_setting": {
            "voice_id": "English_expressive_narrator",
            "speed": 1.1
          },
          "subtitle_enable": true,
          "subtitle_type": "word"
        }
      },
      "response": {
        "status": 200,
        "json": {
          "data": {
            "audio": "",
            "status": 2,
            "subtitle_file": "https://cdn.example.com/sub.json"
          },
          "extra_info": {
            "audio_length": 1200,
            "audio_format": "mp3"
          },
          "trace_id": "t1",
          "base_resp": {
            "status_code": 0,
            "status_msg": "success"
          }
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://cdn.example.com/sub.json"
      },
      "response": {
        "status": 200,
        "json": [
          {
            "text": "Hello world.",
            "time_begin": 0,
            "time_end": 1150,
            "text_begin": 0,
            "text_end": 12,
            "timestamped_words": [
              {
                "word": "Hello",
                "word_begin": 0,
                "word_end": 5,
                "time_begin": 0,
                "time_end": 480
              },
              {
                "word": "world.",
                "word_begin": 6,
                "word_end": 12,
                "time_begin": 520,
                "time_end": 1150
              }
            ]
          }
        ]
      }
    }
  ],
  "expect": {
    "status": "completed",
    "files": [
      {
        "mime": "audio/mpeg"
      }
    ]
  }
}
