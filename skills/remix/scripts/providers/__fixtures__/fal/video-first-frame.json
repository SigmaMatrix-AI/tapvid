{
  "capability": "video.generate",
  "request": {
    "params": {
      "prompt": "The leaves start to move",
      "aspect": "9:16",
      "duration_s": 5,
      "first_frame": "_assets/tiny.png",
      "audio": true
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "url": "https://rest.fal.ai/storage/upload/initiate?storage_type=fal-cdn-v3",
        "bodyIncludes": {
          "content_type": "image/png"
        },
        "headers": {
          "authorization": "Key test-FAL_KEY"
        }
      },
      "response": {
        "status": 200,
        "json": {
          "upload_url": "https://upload.fal.media/u/f1?sig=1",
          "file_url": "https://v3.fal.media/files/f1"
        }
      }
    },
    {
      "request": {
        "method": "PUT",
        "url": "https://upload.fal.media/u/f1?sig=1",
        "headers": {
          "content-type": "image/png"
        }
      },
      "response": {
        "status": 200,
        "text": ""
      }
    },
    {
      "request": {
        "method": "POST",
        "url": "https://queue.fal.run/bytedance/seedance-2.5/image-to-video",
        "bodyIncludes": {
          "image_url": "https://v3.fal.media/files/f1",
          "duration": "5",
          "resolution": "480p",
          "generate_audio": true
        }
      },
      "response": {
        "status": 200,
        "json": {
          "request_id": "r2",
          "response_url": "https://queue.fal.run/bytedance/seedance-2.5/requests/r2",
          "status_url": "https://queue.fal.run/bytedance/seedance-2.5/requests/r2/status",
          "cancel_url": "https://queue.fal.run/bytedance/seedance-2.5/requests/r2/cancel"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://queue.fal.run/bytedance/seedance-2.5/requests/r2/status"
      },
      "response": {
        "status": 200,
        "json": {
          "status": "COMPLETED"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://queue.fal.run/bytedance/seedance-2.5/requests/r2"
      },
      "response": {
        "status": 200,
        "json": {
          "video": {
            "url": "https://v3.fal.media/files/out2.mp4"
          },
          "seed": 1
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "url": "https://v3.fal.media/files/out2.mp4"
      },
      "response": {
        "status": 200,
        "file": "_assets/tiny.mp4"
      }
    }
  ],
  "expect": {
    "status": "completed",
    "files": [
      {
        "mime": "video/mp4"
      }
    ]
  }
}
