{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "video.understand",
  "$defs": {
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "shots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "question": {
          "type": "string"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files"
      ],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file"
          }
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mime"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "mime": {
          "type": "string",
          "minLength": 1
        },
        "duration_s": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "words": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/word"
          }
        },
        "bpm": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "start",
        "end"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
