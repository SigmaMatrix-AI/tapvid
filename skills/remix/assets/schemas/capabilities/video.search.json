{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "video.search",
  "$defs": {
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "sort": {
          "enum": [
            "views",
            "recent",
            "relevance"
          ]
        },
        "duration": {
          "enum": [
            "short",
            "medium",
            "long"
          ]
        },
        "orientation": {
          "enum": [
            "landscape",
            "portrait",
            "square"
          ]
        },
        "published_after": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "url"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "provider": {
                "type": "string"
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "download_url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "thumbnail_url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "duration_s": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "width": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "height": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "views": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "published_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "channel": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "license": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "attribution": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mime"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "mime": {
          "type": "string",
          "minLength": 1
        },
        "duration_s": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "words": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/word"
          }
        },
        "bpm": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "start",
        "end"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
