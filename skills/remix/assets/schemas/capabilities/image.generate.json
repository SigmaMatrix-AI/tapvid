{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "image.generate",
  "$defs": {
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt",
        "aspect"
      ],
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "aspect": {
          "type": "string",
          "enum": [
            "16:9",
            "9:16",
            "1:1",
            "4:3",
            "3:4",
            "21:9"
          ]
        },
        "min_short_edge": {
          "type": "integer",
          "minimum": 1
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "role"
            ],
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "composition",
                  "subject",
                  "style"
                ]
              }
            }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files"
      ],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file"
          }
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "mime"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "mime": {
          "type": "string",
          "minLength": 1
        },
        "duration_s": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "words": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/word"
          }
        },
        "bpm": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "start",
        "end"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
