{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "replicas/<slug>/replica.json",
  "$defs": {
    "media": {
      "type": "object",
      "required": [
        "kind",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "image",
            "video",
            "avatar",
            "element"
          ]
        },
        "source": {
          "enum": [
            "ai",
            "code",
            "user"
          ]
        },
        "mode": {
          "enum": [
            "reference",
            "keyframe",
            "text"
          ]
        },
        "reference_ok": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "replace": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "prompt": {
          "type": "string"
        },
        "visual": {
          "type": "string"
        },
        "aspect": {
          "type": "string"
        },
        "duration_s": {
          "type": "number",
          "minimum": 0
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "sketch": {
          "type": [
            "string",
            "null"
          ]
        },
        "loop": {
          "type": "boolean"
        },
        "credit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": { "type": ["string", "null"] },
            "url": { "type": ["string", "null"] },
            "author": { "type": ["string", "null"] },
            "via": { "type": "string" }
          }
        },
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "attribution": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "type": "object",
  "required": [
    "version",
    "slug",
    "topic",
    "language",
    "template",
    "audio",
    "scenes"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,40}$"
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "template": {
      "type": "string",
      "minLength": 1
    },
    "product": {
      "type": [
        "string",
        "null"
      ]
    },
    "replace": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "subject",
          "with"
        ],
        "additionalProperties": false,
        "properties": {
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "with": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "generate": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "narration",
            "music-only",
            "silent"
          ]
        },
        "voice": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string"
            }
          }
        },
        "captions": {
          "type": [
            "string",
            "null"
          ]
        },
        "bgm": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "brief": {
              "type": "string"
            },
            "candidates": {
              "type": "array"
            },
            "selected": {
              "type": "integer",
              "minimum": 0
            },
            "path": {
              "type": [
                "string",
                "null"
              ]
            },
            "beats": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "board",
          "data",
          "media"
        ],
        "additionalProperties": false,
        "properties": {
          "board": {
            "type": "string",
            "minLength": 1
          },
          "beat": {
            "type": "string"
          },
          "narration": {
            "type": "string"
          },
          "data": {
            "type": "object"
          },
          "media": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/media"
            }
          }
        }
      }
    },
    "resolved": {
      "type": "object"
    }
  }
}
